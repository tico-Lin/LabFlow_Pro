{
  "id": "drive_oauth",
  "name": "Cloud Drive Integrations",
  "version": "1.0.0",
  "description": "OAuth 2.0 authorization flows for Google Drive and OneDrive CRDT sync.",
  "engine": "wasm",
  "execute_cmd": ["drive_sync.wasm"],
  "supported_formats": ["*"],
  "permissions": ["network.http", "fs.read", "fs.write"],
  "parameters": {
    "provider": {
      "type": "string",
      "enum": ["google_drive", "onedrive"],
      "description": "The cloud provider to authenticate with."
    },
    "action": {
      "type": "string",
      "enum": ["auth", "sync_up", "sync_down"]
    }
  },
  "providers": {
    "GoogleDrive": {
      "client_id": "mock-gdrive-client-id",
      "scopes": ["https://www.googleapis.com/auth/drive.file"]
    },
    "OneDrive": {
      "client_id": "mock-onedrive-client-id",
      "scopes": ["Files.ReadWrite.All"]
    }
  }
}
